@{
    ViewData["Title"] = "Item Storage";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;1,500&family=Outfit:wght@400;500;600&display=swap');

    :root {
        --forest: #1C3B2E;
        --forest-dark: #0D201A;
        --forest-mid: #2E6B52;
        --sage: #4A9572;
        --sage-light: #EAF3EE;
        --sage-muted: #9CBDAD;
        --amber: #C9863A;
        --amber-light: #FDF3E7;
        --amber-hover: #B5722A;
        --ink: #111318;
        --ink2: #3D3F47;
        --muted: #7C808C;
        --line: #E3E5EA;
        --sand: #F8F7F4;
        --white: #FFFFFF;
        --font-d: 'Montserrat', Georgia, serif;
        --font-b: 'Outfit', system-ui, sans-serif;
        --r: 10px;
    }

    .log-page * {
        box-sizing: border-box;
    }

    .log-page {
        font-family: var(--font-b);
        color: var(--ink);
        background: var(--sand);
    }

        .log-page p, .log-page h1, .log-page h2, .log-page h3, .log-page h4 {
            margin: 0;
        }

        .log-page a {
            text-decoration: none;
        }

    .log-header {
        background: var(--forest);
        padding: 3rem 3rem 2.5rem;
    }

    .log-header-inner {
        max-width: 1100px;
        margin: 0 auto;
    }

    .log-eyebrow {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1.8px;
        text-transform: uppercase;
        color: var(--sage);
        margin-bottom: 10px;
    }

    .log-header h1 {
        font-family: var(--font-d);
        font-size: 40px;
        font-weight: 900;
        color: #fff;
        line-height: 1.15;
        margin-bottom: 10px;
    }

    .log-header p {
        font-size: 16px;
        color: var(--sage-muted);
        max-width: 520px;
        line-height: 1.7;
    }

    /* ── HOW YOUR ORDER WORKS (shown before the pickup form) ── */
    .howitworks-panel {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 3rem 0;
    }

    .order-panel {
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: 14px;
        overflow: hidden;
    }

    .order-panel-head {
        background: var(--forest);
        padding: 1.25rem 1.5rem;
    }

        .order-panel-head h3 {
            font-family: var(--font-d);
            font-size: 18px;
            color: #fff;
            margin-bottom: 3px;
        }

        .order-panel-head p {
            font-size: 12px;
            color: var(--sage-muted);
        }

    .order-panel-body {
        padding: 1.5rem;
    }

    .order-steps {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
    }

    .order-step {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        flex: 1 1 220px;
        min-width: 200px;
    }

    .ostep-num {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: var(--sage-light);
        color: var(--forest-mid);
        font-size: 12px;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-top: 1px;
    }

    .ostep-text strong {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: var(--ink);
        margin-bottom: 2px;
    }

    .ostep-text span {
        font-size: 12px;
        color: var(--muted);
        line-height: 1.5;
    }

    @@media (max-width: 700px) {
        .howitworks-panel {
            padding: 1.5rem 1.25rem 0;
        }

        .order-steps {
            flex-direction: column;
        }
    }

    .pickup-bar {
        background: var(--amber-light);
        border-bottom: 1px solid #F0D9BE;
        padding: 1rem 3rem;
    }

    .pickup-bar-inner {
        max-width: 1100px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        gap: 2rem;
        flex-wrap: wrap;
    }

    .pickup-label {
        font-size: 13px;
        font-weight: 600;
        color: #7A5020;
        display: flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
    }

        .pickup-label i {
            font-size: 17px;
            color: var(--amber);
        }

    .pickup-fields {
        display: flex;
        gap: 1rem;
        align-items: center;
        flex-wrap: wrap;
        flex: 1;
    }

    .pickup-field {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

        .pickup-field label {
            display: flex;
            align-items: center;
            gap: 4px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #A0701A;
        }

        .field-hint-toggle {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: none;
            background: none;
            padding: 0;
            color: #A0701A;
            cursor: pointer;
            font-size: 14px;
            line-height: 1;
        }

        .field-optional-tag {
            text-transform: none;
            font-weight: 500;
            letter-spacing: normal;
            opacity: 0.65;
        }

        .field-hint {
            max-width: 240px;
            font-size: 11px;
            font-weight: 400;
            text-transform: none;
            letter-spacing: normal;
            line-height: 1.4;
            color: #7A5020;
            background: #fff;
            border: 1px solid #F0D9BE;
            border-radius: 6px;
            padding: 8px 10px;
            margin-top: 2px;
        }

            .field-hint strong {
                display: block;
                margin-bottom: 3px;
                color: #5A3B10;
            }

        .pickup-field input[type="date"], .pickup-field input[type="time"], .pickup-field input[type="text"] {
            font-family: var(--font-b);
            font-size: 13px;
            font-weight: 500;
            color: var(--ink);
            background: var(--white);
            border: 1px solid #F0D9BE;
            border-radius: 7px;
            padding: 7px 12px;
            outline: none;
            cursor: pointer;
        }

        .pickup-field input[type="text"] {
            cursor: text;
            min-width: 160px;
        }

        .pickup-field input:focus {
            border-color: var(--amber);
        }

        .pickup-field select {
            font-family: var(--font-b);
            font-size: 13px;
            font-weight: 500;
            color: var(--ink);
            background: var(--white);
            border: 1px solid #F0D9BE;
            border-radius: 7px;
            padding: 7px 12px;
            outline: none;
            cursor: pointer;
            min-width: 170px;
        }

        .pickup-field select:focus {
            border-color: var(--amber);
        }

        .pickup-field #previous-hostel-other {
            margin-top: 5px;
        }

    .pickup-fixed-value {
        font-family: var(--font-b);
        font-size: 13px;
        font-weight: 600;
        color: var(--ink);
        background: var(--white);
        border: 1px solid #F0D9BE;
        border-radius: 7px;
        padding: 7px 12px;
        display: flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }

        .pickup-fixed-value i {
            font-size: 14px;
            color: var(--amber);
        }

    /* Explicit, tappable pickup-date list — replaces the native
       <input type="date"> picker, whose calendar/wheel UI can render
       confusingly (or appear to offer only one date) on some phone
       browsers. */
    .pickup-date-chips {
        display: flex;
        gap: 6px;
        overflow-x: auto;
        max-width: 280px;
        padding-bottom: 2px;
    }

    .date-chip {
        flex: 0 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1px;
        font-family: var(--font-b);
        background: var(--white);
        border: 1px solid #F0D9BE;
        border-radius: 7px;
        padding: 6px 10px;
        cursor: pointer;
        font-size: 11px;
        color: var(--ink);
        line-height: 1.2;
        white-space: nowrap;
    }

        .date-chip .dc-day {
            font-weight: 700;
            font-size: 13px;
        }

        .date-chip.selected {
            background: var(--amber);
            border-color: var(--amber);
            color: #fff;
        }

    .fixed-tag {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--amber);
        background: var(--amber-light);
        padding: 2px 7px;
        border-radius: 99px;
        margin-left: 2px;
    }

    .return-notice {
        max-width: 1100px;
        margin: 0.75rem auto 0;
        background: var(--white);
        border: 1px solid #F0D9BE;
        border-radius: 8px;
        padding: 0.65rem 1rem;
        font-size: 13px;
        color: #7A5020;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .return-notice i {
            font-size: 16px;
            color: var(--amber);
            flex-shrink: 0;
        }

    .log-body {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2.5rem 3rem;
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 2.5rem;
        align-items: start;
    }

    .catalog-filters {
        display: flex;
        gap: 8px;
        margin-bottom: 1.75rem;
        flex-wrap: wrap;
    }

    .filter-btn {
        padding: 7px 16px;
        border-radius: 99px;
        border: 1px solid var(--line);
        background: var(--white);
        font-size: 13px;
        font-weight: 500;
        color: var(--muted);
        cursor: pointer;
        font-family: var(--font-b);
        transition: all 0.15s;
    }

        .filter-btn:hover {
            border-color: var(--sage);
            color: var(--forest);
        }

        .filter-btn.active {
            background: var(--forest);
            color: #fff;
            border-color: var(--forest);
        }

    .catalog-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
    }

    .item-card {
        background: var(--white);
        border: 1.5px solid var(--line);
        border-radius: 12px;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 10px;
        transition: border-color 0.15s, box-shadow 0.15s;
        position: relative;
    }

        .item-card:hover {
            border-color: var(--sage);
            box-shadow: 0 4px 18px rgba(28,59,46,0.07);
        }

        .item-card.in-order {
            border-color: var(--forest-mid);
            background: var(--sage-light);
        }

    .item-icon-wrap {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: var(--sage-light);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .item-card.in-order .item-icon-wrap {
        background: rgba(46,107,82,0.15);
    }

    .item-icon-wrap i {
        font-size: 22px;
        color: var(--forest-mid);
    }

    .item-name {
        font-size: 14px;
        font-weight: 600;
        color: var(--ink);
        line-height: 1.3;
    }

    .item-desc {
        font-size: 12px;
        color: var(--muted);
        line-height: 1.5;
        flex: 1;
    }

    .item-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: auto;
    }

    .item-price {
        font-size: 15px;
        font-weight: 600;
        color: var(--amber);
    }

    .qty-control {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .qty-btn {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: 1.5px solid var(--line);
        background: var(--white);
        color: var(--ink);
        font-size: 16px;
        font-weight: 500;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        transition: background 0.12s, border-color 0.12s;
        font-family: var(--font-b);
    }

        .qty-btn:hover {
            background: var(--sage-light);
            border-color: var(--sage);
        }

    .qty-num {
        font-size: 14px;
        font-weight: 600;
        color: var(--ink);
        min-width: 20px;
        text-align: center;
    }

    .order-panel {
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: 14px;
        overflow: hidden;
        position: sticky;
        top: 84px;
    }

    .order-head {
        background: var(--forest);
        padding: 1.25rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .order-head h3 {
            font-family: var(--font-d);
            font-size: 18px;
            color: #fff;
        }

    .order-badge {
        background: var(--amber);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        padding: 3px 9px;
        border-radius: 99px;
        display: none;
    }

    .order-body {
        padding: 1.25rem 1.5rem;
    }

    .order-empty {
        text-align: center;
        padding: 2rem 1rem;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.6;
    }

        .order-empty i {
            font-size: 36px;
            color: var(--line);
            display: block;
            margin-bottom: 10px;
        }

    .order-lines {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .order-line {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid var(--line);
        font-size: 13px;
    }

        .order-line:last-child {
            border-bottom: none;
        }

    .ol-name {
        font-weight: 500;
        color: var(--ink);
        flex: 1;
    }

    .ol-qty {
        color: var(--muted);
        margin: 0 12px;
    }

    .ol-price {
        font-weight: 600;
        color: var(--ink2);
    }

    .ol-remove {
        background: none;
        border: none;
        color: var(--muted);
        cursor: pointer;
        font-size: 16px;
        padding: 0 0 0 8px;
        line-height: 1;
        transition: color 0.12s;
    }

        .ol-remove:hover {
            color: #D94040;
        }

    .order-divider {
        height: 1px;
        background: var(--line);
        margin: 1rem 0;
    }

    .order-total-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 1.25rem;
    }

    .order-total-label {
        font-size: 13px;
        color: var(--muted);
        font-weight: 500;
    }

    .order-total-amount {
        font-family: var(--font-d);
        font-size: 26px;
        font-weight: 600;
        color: var(--forest);
    }

    .btn-checkout {
        display: block;
        width: 100%;
        background: var(--amber);
        color: #fff;
        border: none;
        padding: 13px;
        border-radius: var(--r);
        font-size: 15px;
        font-weight: 600;
        font-family: var(--font-b);
        cursor: pointer;
        text-align: center;
        transition: background 0.15s;
        text-decoration: none;
    }

        .btn-checkout:hover {
            background: var(--amber-hover);
            color: #fff;
        }

        .btn-checkout:disabled {
            background: var(--line);
            color: var(--muted);
            cursor: not-allowed;
        }

    .order-note {
        margin-top: 10px;
        font-size: 11px;
        color: var(--muted);
        text-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

        .order-note i {
            font-size: 13px;
        }

    @@media (max-width: 900px) {
        .log-body {
            grid-template-columns: 1fr;
            padding: 2rem 1.5rem;
        }

        .order-panel {
            position: static;
        }

        .catalog-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .log-header {
            padding: 2.5rem 1.5rem 2rem;
        }

        .pickup-bar {
            padding: 1rem 1.5rem;
        }

        .return-notice {
            margin-left: 0;
            margin-right: 0;
        }
    }

    @@media (max-width: 500px) {
        .catalog-grid {
            grid-template-columns: 1fr;
        }

        .log-header h1 {
            font-size: 28px;
        }
    }
</style>

<div class="log-page">

    <!-- PAGE HEADER -->
    <div class="log-header">
        <div class="log-header-inner">
            <p class="log-eyebrow">Logistics &amp; storage</p>
            <h1>Store your items.<br>We'll keep them safe.</h1>
            <p>Select what you need stored, pick a pickup date, and we'll handle the rest. Everything comes back when you return to campus.</p>
        </div>
    </div>

    <!-- HOW YOUR ORDER WORKS (shown first, before the pickup form) -->
    <div class="howitworks-panel">
        <div class="order-panel">
            <div class="order-panel-head">
                <h3>How your order works</h3>
                <p>Simple 4-step process, door to door</p>
            </div>
            <div class="order-panel-body">
                <div class="order-steps">
                    <div class="order-step">
                        <div class="ostep-num">1</div>
                        <div class="ostep-text">
                            <strong>Pick your items</strong>
                            <span>Browse the full item catalog and select what you want stored, with quantities.</span>
                        </div>
                    </div>
                    <div class="order-step">
                        <div class="ostep-num">2</div>
                        <div class="ostep-text">
                            <strong>Choose pickup date</strong>
                            <span>Select a date before your vacation starts. We'll be at your door on time.</span>
                        </div>
                    </div>
                    <div class="order-step">
                        <div class="ostep-num">3</div>
                        <div class="ostep-text">
                            <strong>Pay via Paystack</strong>
                            <span>Card, mobile money, or bank transfer. Your items are insured from the moment we collect.</span>
                        </div>
                    </div>
                    <div class="order-step">
                        <div class="ostep-num">4</div>
                        <div class="ostep-text">
                            <strong>We return everything</strong>
                            <span>Set your return date and your belongings will be waiting when you get back.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PICKUP DATE BAR -->
    <div class="pickup-bar">
        <div class="pickup-bar-inner">
            <div class="pickup-label">
                <i class="ti ti-calendar" aria-hidden="true"></i>
                Schedule your pickup
            </div>
            <div class="pickup-fields">
                <div class="pickup-field">
                    <label id="pickup-date-label">Pickup date</label>
                    <div class="pickup-date-chips" id="pickup-date-chips" role="listbox" aria-labelledby="pickup-date-label"></div>
                    <input type="hidden" id="pickup-date" />
                </div>
                <div class="pickup-field">
                    <label for="pickup-time">Pickup time</label>
                    <div class="pickup-fixed-value" id="pickup-time">
                        <i class="ti ti-clock" aria-hidden="true"></i> @ViewBag.FixedPickupTimeDisplay <span class="fixed-tag">Fixed</span>
                    </div>
                </div>
                <div class="pickup-field">
                    <label for="previous-hostel-select">Current hostel</label>
                    <select id="previous-hostel-select">
                        <option value="" disabled selected>Select your hall/hostel</option>
                        <option value="Unity Hall">Unity Hall</option>
                        <option value="Independence Hall">Independence Hall</option>
                        <option value="Queen Elizabeth Hall">Queen Elizabeth Hall</option>
                        <option value="Africa Hall">Africa Hall</option>
                        <option value="Katanga Hall">Katanga Hall</option>
                        <option value="Republic Hall">Republic Hall</option>
                        <option value="__other__">Other…</option>
                    </select>
                    <input type="text" id="previous-hostel-other" placeholder="Type your hall or hostel name" hidden />
                    <!-- Hidden field holds whichever value is actually current — the
                         picked hall name, or whatever was typed into "Other" — so the
                         rest of the checkout logic (goToCheckout, restoreSavedOrder)
                         can keep reading a single #previous-hostel value like before. -->
                    <input type="hidden" id="previous-hostel" />
                </div>
                <div class="pickup-field">
                    <label for="room-number">Room number</label>
                    <input type="text" id="room-number" placeholder="e.g. A204" />
                </div>
                <div class="pickup-field">
                    <label for="new-hostel">
                        Return to hostel <span class="field-optional-tag">(optional)</span>
                        <button type="button" class="field-hint-toggle" id="newHostelHintToggle" aria-label="Help — what to enter if your place has no name" aria-expanded="false">
                            <i class="ti ti-info-circle" aria-hidden="true"></i>
                        </button>
                    </label>
                    <input type="text" id="new-hostel" placeholder="e.g. Evandy hostel — leave blank if not yet known" />
                    <div class="field-hint" id="newHostelHint" hidden>
                        <strong>Moving to a homestel, or your place has no name?</strong>
                        State the nearest hostel and the distance it is from your place — e.g. "5 min walk from Evandy hostel".
                    </div>
                </div>
                <div class="pickup-field">
                    <label for="phone-number">Phone number</label>
                    <input type="tel" id="phone-number" placeholder="e.g. 024 123 4567" />
                </div>
            </div>
        </div>
        <div class="return-notice">
            <i class="ti ti-alert-triangle" aria-hidden="true"></i>
            All items will be returned on <strong>@ViewBag.FixedReturnDate</strong>. Failure to be present for return on this day will result in delivery charges.
        </div>
    </div>

    <!-- MAIN BODY -->
    <div class="log-body">

        <!-- CATALOG -->
        <div>
            <div class="catalog-filters">
                <button class="filter-btn active" data-cat="all">All items</button>
                <button class="filter-btn" data-cat="appliances & electronics">Appliances &amp; Electronics</button>
                <button class="filter-btn" data-cat="bags & boxes">Bags &amp; Boxes</button>
                <button class="filter-btn" data-cat="furniture & bedding">Furniture &amp; Bedding</button>
                <button class="filter-btn" data-cat="kitchen & utility">Kitchen &amp; Utility</button>
            </div>

            <div class="catalog-grid" id="catalog-grid">
                @if (ViewBag.Items != null)
                {
                    @foreach (var item in (IEnumerable<HostelSite.ViewModels.LogisticsItemViewModel>)ViewBag.Items)
                    {
                        <div class="item-card" data-id="@item.Id" data-name="@item.Name" data-price="@item.Price" data-cat="@item.Category?.ToLower()">
                            <div class="item-icon-wrap">
                                <i class="ti ti-package" aria-hidden="true"></i>
                            </div>
                            <div class="item-name">@item.Name</div>
                            <div class="item-desc">@item.Description</div>
                            <div class="item-footer">
                                <div class="item-price">GH₵ @item.Price.ToString("0.00")</div>
                                <div class="qty-control">
                                    <button class="qty-btn" onclick="changeQty(@item.Id, -1)" aria-label="Remove one">−</button>
                                    <span class="qty-num" id="qty-@item.Id">0</span>
                                    <button class="qty-btn" onclick="changeQty(@item.Id, 1)" aria-label="Add one">+</button>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="grid-column:1/-1; text-align:center; padding:3rem; color:var(--muted);">
                        No items available right now.
                    </div>
                }
            </div>
        </div>

        <!-- ORDER PANEL -->
        <div class="order-panel">
            <div class="order-head">
                <h3>My order</h3>
                <span class="order-badge" id="order-badge">0</span>
            </div>
            <div class="order-body">
                <div class="order-empty" id="order-empty">
                    <i class="ti ti-package" aria-hidden="true"></i>
                    Add items from the catalog to build your storage order.
                </div>
                <div class="order-lines" id="order-lines" style="display:none;"></div>

                <div id="order-summary" style="display:none;">
                    <div class="order-divider"></div>
                    <div class="order-total-row">
                        <span class="order-total-label">Total</span>
                        <span class="order-total-amount" id="order-total">GH₵ 0</span>
                    </div>
                    <button class="btn-checkout" id="checkout-btn" onclick="goToCheckout()">
                        Proceed to checkout →
                    </button>
                    <p class="order-note">
                        <i class="ti ti-shield-check" aria-hidden="true"></i>
                        All items insured from pickup
                    </p>
                </div>

                <div id="order-empty-checkout" style="display:none; margin-top:1rem;">
                    <button class="btn-checkout" disabled>Proceed to checkout →</button>
                    <p class="order-note">
                        <i class="ti ti-info-circle" aria-hidden="true"></i>
                        Add at least one item to continue
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const order = {};

        function changeQty(id, delta) {
            const card  = document.querySelector(`.item-card[data-id="${id}"]`);
            const name  = card.dataset.name;
            const price = parseFloat(card.dataset.price);
            const qtyEl = document.getElementById('qty-' + id);

            order[id] = order[id] || { name, price, qty: 0 };
            order[id].qty = Math.max(0, order[id].qty + delta);
            qtyEl.textContent = order[id].qty;

            if (order[id].qty === 0) delete order[id];

            card.classList.toggle('in-order', !!(order[id] && order[id].qty > 0));
            renderOrder();
        }

        function goToCheckout() {
            const pickup     = document.getElementById('pickup-date').value;
            const time        = '@ViewBag.FixedPickupTime';        // window start, stored as the order's TimeOnly value — not user-selectable
            const timeDisplay = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)ViewBag.FixedPickupTimeDisplay)); // e.g. "5:00 PM – 6:00 PM" — for display only
            const prevHostel = document.getElementById('previous-hostel').value.trim();
            const roomNumber = document.getElementById('room-number').value.trim();
            const newHostel  = document.getElementById('new-hostel').value.trim();
            const phone      = document.getElementById('phone-number').value.trim();

            if (Object.keys(order).length === 0) {
                alert('Please add at least one item to your order.');
                return;
            }
            if (!pickup) { alert('Please select a pickup date.'); return; }
            if (!prevHostel) { alert('Please enter your current hostel.'); return; }
            if (!roomNumber) { alert('Please enter your room number at your current hostel.'); return; }
            // "Return to hostel" is optional — some students don't know it yet at booking time.
            if (!phone) { alert('Please enter a phone number so we can contact you.'); return; }

            const items = Object.keys(order).map(id => ({
                itemId:   parseInt(id),
                name:     order[id].name,
                price:    order[id].price,
                quantity: order[id].qty,
                icon:     'ti-package'
            }));

            const total = items.reduce((s, i) => s + i.price * i.quantity, 0);

            sessionStorage.setItem('nestOrder', JSON.stringify({
                items:             items,
                total:             total,
                pickup:            pickup,
                pickupTime:        time,
                pickupTimeDisplay: timeDisplay,
                previousHostel:    prevHostel,
                roomNumber:        roomNumber,
                newHostel:         newHostel,
                phone:             phone,
                returnDate:        '@ViewBag.FixedReturnDate'
            }));

            window.location.href = '@Url.Action("Checkout", "Logistics")';
        }

        function renderOrder() {
            const ids    = Object.keys(order);
            const empty  = document.getElementById('order-empty');
            const lines  = document.getElementById('order-lines');
            const summary= document.getElementById('order-summary');
            const badge  = document.getElementById('order-badge');
            const emptyC = document.getElementById('order-empty-checkout');

            if (ids.length === 0) {
                empty.style.display  = '';
                lines.style.display  = 'none';
                summary.style.display= 'none';
                emptyC.style.display = 'none';
                badge.style.display  = 'none';
                return;
            }

            empty.style.display  = 'none';
            lines.style.display  = '';
            summary.style.display= '';
            emptyC.style.display = 'none';
            badge.style.display  = '';

            let total    = 0;
            let itemCount= 0;
            lines.innerHTML = '';

            ids.forEach(id => {
                const { name, price, qty } = order[id];
                const lineTotal = price * qty;
                total     += lineTotal;
                itemCount += qty;

                const el  = document.createElement('div');
                el.className = 'order-line';
                el.innerHTML = `
                    <span class="ol-name">${name}</span>
                    <span class="ol-qty">x${qty}</span>
                    <span class="ol-price">GH₵ ${lineTotal.toFixed(2)}</span>
                    <button class="ol-remove" onclick="removeItem(${id})" aria-label="Remove ${name}">
                        <i class="ti ti-x" aria-hidden="true"></i>
                    </button>`;
                lines.appendChild(el);
            });

            badge.textContent = itemCount;
            document.getElementById('order-total').textContent = 'GH₵ ' + total.toFixed(2);

            sessionStorage.setItem('nestOrder', JSON.stringify(order));
        }

        function removeItem(id) {
            const card = document.querySelector(`.item-card[data-id="${id}"]`);
            if (!card) return;
            order[id] = undefined;
            delete order[id];
            const qtyEl = document.getElementById('qty-' + id);
            if (qtyEl) qtyEl.textContent = '0';
            card.classList.remove('in-order');
            renderOrder();
        }

        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                const cat = btn.dataset.cat;
                document.querySelectorAll('.item-card').forEach(card => {
                    card.style.display = (cat === 'all' || card.dataset.cat === cat) ? '' : 'none';
                });
            });
        });

        document.addEventListener('DOMContentLoaded', function () {
            renderPickupDateChips();
            restoreSavedOrder();
        });

        document.getElementById('newHostelHintToggle')?.addEventListener('click', function () {
            const hint = document.getElementById('newHostelHint');
            if (!hint) return;
            hint.hidden = !hint.hidden;
            this.setAttribute('aria-expanded', String(!hint.hidden));
        });

        // ── Current-hostel dropdown ──
        // The 6 traditional halls, exactly as they should be stored — picking
        // one of these means the name always lands in the DB spelled the same
        // way, so lookups (e.g. staff searching a booking by hall) don't fail
        // over "Unity hall" vs "unity Hall" vs a typo. "Other…" still lets a
        // student in a non-traditional hostel type their own name in.
        const TRADITIONAL_HALLS = [
            'Unity Hall', 'Independence Hall', 'Queen Elizabeth Hall',
            'Africa Hall', 'Katanga Hall', 'Republic Hall'
        ];

        const prevHostelSelect = document.getElementById('previous-hostel-select');
        const prevHostelOther  = document.getElementById('previous-hostel-other');
        const prevHostelHidden = document.getElementById('previous-hostel');

        // Sets the select + "other" input + hidden field from a single string
        // value — used on first load restore (see restoreSavedOrder) and could
        // be reused anywhere else a saved hostel name needs to populate this
        // control.
        function setPreviousHostelValue(value) {
            if (!value) return;
            const match = TRADITIONAL_HALLS.find(h => h.toLowerCase() === value.trim().toLowerCase());
            if (match) {
                prevHostelSelect.value = match;
                prevHostelOther.hidden = true;
                prevHostelOther.value = '';
                prevHostelHidden.value = match;
            } else {
                prevHostelSelect.value = '__other__';
                prevHostelOther.hidden = false;
                prevHostelOther.value = value;
                prevHostelHidden.value = value;
            }
        }

        prevHostelSelect?.addEventListener('change', function () {
            if (this.value === '__other__') {
                prevHostelOther.hidden = false;
                prevHostelOther.value = '';
                prevHostelHidden.value = '';
                prevHostelOther.focus();
            } else {
                prevHostelOther.hidden = true;
                prevHostelOther.value = '';
                prevHostelHidden.value = this.value;
            }
        });

        prevHostelOther?.addEventListener('input', function () {
            prevHostelHidden.value = this.value.trim();
        });

        // Renders the next 21 days (tomorrow onward) as tappable chips and
        // wires each one to set the hidden #pickup-date input that
        // goToCheckout() and restoreSavedOrder() already read from.
        function renderPickupDateChips(selectedIso) {
            const container   = document.getElementById('pickup-date-chips');
            const pickupInput = document.getElementById('pickup-date');
            if (!container || !pickupInput) return;

            container.innerHTML = '';
            const dayNames   = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
            const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

            for (let i = 1; i <= 21; i++) {
                const d = new Date();
                d.setHours(0, 0, 0, 0);
                d.setDate(d.getDate() + i);
                const iso = d.toISOString().split('T')[0];

                const chip = document.createElement('button');
                chip.type = 'button';
                chip.className = 'date-chip';
                chip.setAttribute('role', 'option');
                chip.dataset.date = iso;
                chip.innerHTML =
                    '<span class="dc-dow">' + dayNames[d.getDay()] + '</span>' +
                    '<span class="dc-day">' + d.getDate() + '</span>' +
                    '<span class="dc-dow">' + monthNames[d.getMonth()] + '</span>';

                if (iso === selectedIso) chip.classList.add('selected');

                chip.addEventListener('click', () => {
                    container.querySelectorAll('.date-chip').forEach(c => c.classList.remove('selected'));
                    chip.classList.add('selected');
                    pickupInput.value = iso;
                });

                container.appendChild(chip);
            }

            if (selectedIso) {
                const match = container.querySelector(`.date-chip[data-date="${selectedIso}"]`);
                if (match) match.scrollIntoView({ inline: 'center', block: 'nearest' });
            }
        }

        // Restores a previously started order — e.g. clicking "Edit" from the
        // Checkout page brings the student back here, and this repopulates the
        // items, quantities, pickup date, and hostel fields instead of leaving
        // everything cleared.
        function restoreSavedOrder() {
            const saved = sessionStorage.getItem('nestOrder');
            if (!saved) return;

            let data;
            try {
                data = JSON.parse(saved);
            } catch (e) {
                return;
            }

            // Full checkout-shape: { items: [...], pickup, previousHostel, newHostel, ... }
            if (data && Array.isArray(data.items)) {
                data.items.forEach(it => {
                    order[it.itemId] = { name: it.name, price: it.price, qty: it.quantity };
                });

                // NOTE: `pickupInput` here used to reference a `const` that only
                // existed inside the DOMContentLoaded callback's own scope, not
                // this function — referencing it threw a ReferenceError any time
                // a saved order had a pickup date (e.g. clicking "Edit" from
                // Checkout), which aborted the rest of this restore (hostel,
                // room, phone, cart quantities never got repopulated either).
                if (data.pickup) {
                    const pickupInput = document.getElementById('pickup-date');
                    if (pickupInput) pickupInput.value = data.pickup;
                    renderPickupDateChips(data.pickup);
                }

                const newHostelInput  = document.getElementById('new-hostel');
                const roomNumberInput = document.getElementById('room-number');
                const phoneInput      = document.getElementById('phone-number');
                if (data.previousHostel) setPreviousHostelValue(data.previousHostel);
                if (data.newHostel && newHostelInput) newHostelInput.value = data.newHostel;
                if (data.roomNumber && roomNumberInput) roomNumberInput.value = data.roomNumber;
                if (data.phone && phoneInput) phoneInput.value = data.phone;
            }
            // Raw cart-shape: { "12": { name, price, qty }, ... }
            else if (data && typeof data === 'object') {
                Object.keys(data).forEach(id => {
                    if (data[id] && typeof data[id].qty === 'number' && data[id].qty > 0) {
                        order[id] = data[id];
                    }
                });
            }

            Object.keys(order).forEach(id => {
                const card  = document.querySelector(`.item-card[data-id="${id}"]`);
                const qtyEl = document.getElementById('qty-' + id);
                if (qtyEl) qtyEl.textContent = order[id].qty;
                if (card)  card.classList.toggle('in-order', order[id].qty > 0);
            });

            renderOrder();
        }
    </script>
}
