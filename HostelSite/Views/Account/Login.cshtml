@{
    ViewData["Title"] = "Log in";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;1,500&family=Outfit:wght@400;500;600&display=swap');

    :root {
        --forest:      #1C3B2E;
        --forest-mid:  #2E6B52;
        --sage:        #4A9572;
        --sage-light:  #EAF3EE;
        --sage-muted:  #9CBDAD;
        --amber:       #C9863A;
        --amber-hover: #B5722A;
        --ink:         #111318;
        --muted:       #7C808C;
        --line:        #E3E5EA;
        --sand:        #F8F7F4;
        --white:       #FFFFFF;
        --font-d:      'Montserrat', Georgia, serif;
        --font-b:      'Outfit', system-ui, sans-serif;
        --r:           10px;
    }

    .auth-page * { box-sizing: border-box; }
    .auth-page {
        font-family: var(--font-b);
        min-height: calc(100vh - 64px);
        display: grid;
        grid-template-columns: 1fr 1fr;
    }

    /* ── LEFT PANEL ── */
    .auth-left {
        background: var(--forest);
        padding: 4rem 3.5rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .auth-left-eyebrow {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1.8px;
        text-transform: uppercase;
        color: var(--sage);
        margin-bottom: 1.5rem;
    }

    .auth-left h2 {
        font-family: var(--font-d);
        font-size: 40px;
        color: #fff;
        font-weight: 600;
        line-height: 1.15;
        margin-bottom: 1.25rem;
        letter-spacing: -0.3px;
    }

    .auth-left h2 em { font-style: italic; color: #A8D8BF; }

    .auth-left p {
        font-size: 15px;
        color: var(--sage-muted);
        line-height: 1.75;
        margin-bottom: 2.5rem;
    }

    .auth-perks { display: flex; flex-direction: column; gap: 1rem; }

    .auth-perk {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .perk-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        background: rgba(74,149,114,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .perk-icon i { font-size: 18px; color: var(--sage); }

    .perk-text strong {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #fff;
        margin-bottom: 2px;
    }

    .perk-text span { font-size: 12px; color: var(--sage-muted); line-height: 1.5; }

    /* ── RIGHT PANEL ── */
    .auth-right {
        background: var(--sand);
        padding: 4rem 3.5rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .auth-right h3 {
        font-family: var(--font-d);
        font-size: 28px;
        color: var(--ink);
        font-weight: 600;
        margin-bottom: 6px;
    }

    .auth-right > p {
        font-size: 14px;
        color: var(--muted);
        margin-bottom: 2rem;
    }

    .auth-right > p a { color: var(--forest-mid); font-weight: 500; text-decoration: none; }
    .auth-right > p a:hover { color: var(--sage); }

    /* form */
    .auth-form { display: flex; flex-direction: column; gap: 1.1rem; max-width: 400px; }

    .field { display: flex; flex-direction: column; gap: 6px; }

    .field label {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--muted);
    }

    .field input {
        padding: 12px 14px;
        border: 1.5px solid var(--line);
        border-radius: 9px;
        font-size: 14px;
        font-family: var(--font-b);
        color: var(--ink);
        background: var(--white);
        outline: none;
        transition: border-color 0.15s, box-shadow 0.15s;
    }

    .field input:focus {
        border-color: var(--sage);
        box-shadow: 0 0 0 3px rgba(74,149,114,0.12);
    }

    .field-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .field-row label {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--muted);
    }

    .forgot-link {
        font-size: 13px;
        color: var(--forest-mid);
        font-weight: 500;
        text-decoration: none;
    }

    .forgot-link:hover { color: var(--sage); }

    .btn-login {
        background: var(--forest);
        color: #fff;
        border: none;
        padding: 13px;
        border-radius: 9px;
        font-size: 15px;
        font-weight: 600;
        font-family: var(--font-b);
        cursor: pointer;
        width: 100%;
        transition: background 0.15s;
        margin-top: 0.25rem;
    }

    .btn-login:hover { background: var(--forest-mid); }

    .auth-divider {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 12px;
        color: var(--muted);
        margin: 0.25rem 0;
    }

    .auth-divider::before,
    .auth-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--line);
    }

    .register-cta {
        text-align: center;
        font-size: 14px;
        color: var(--muted);
        margin-top: 0.25rem;
    }

    .register-cta a {
        color: var(--forest-mid);
        font-weight: 600;
        text-decoration: none;
    }

    .register-cta a:hover { color: var(--sage); }

    /* validation */
    .val-error {
        font-size: 12px;
        color: #C0392B;
        margin-top: 2px;
    }

    @@media (max-width: 768px) {
        .auth-page  { grid-template-columns: 1fr; }
        .auth-left  { display: none; }
        .auth-right { padding: 3rem 1.5rem; }
    }
</style>

<div class="auth-page">

    <!-- LEFT -->
    <div class="auth-left">
        <p class="auth-left-eyebrow">Welcome back</p>
        <h2>Good to see<br>you <em>again.</em></h2>
        <p>Log in to manage your aesthetic requests, track your storage orders, and schedule pickups.</p>
        <div class="auth-perks">
            <div class="auth-perk">
                <div class="perk-icon"><i class="ti ti-palette"></i></div>
                <div class="perk-text">
                    <strong>Track aesthetic requests</strong>
                    <span>See the status of your room decoration from request to completion.</span>
                </div>
            </div>
            <div class="auth-perk">
                <div class="perk-icon"><i class="ti ti-package"></i></div>
                <div class="perk-text">
                    <strong>Manage storage orders</strong>
                    <span>View your items, pickup dates, and return schedules in one place.</span>
                </div>
            </div>
            <div class="auth-perk">
                <div class="perk-icon"><i class="ti ti-receipt"></i></div>
                <div class="perk-text">
                    <strong>Payment history</strong>
                    <span>Download receipts and track all your transactions.</span>
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT -->
    <div class="auth-right">
        <h3>Log in to PROSBEE</h3>
        <p>Don't have an account? <a asp-controller="Account" asp-action="Register">Sign up free</a></p>

        <form class="auth-form" asp-controller="Account" asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ReturnUrl" value="@ViewData["ReturnUrl"]" />

            <div class="field">
                <label>Email address</label>
                <input type="email" name="Email" placeholder="you@email.com" required autocomplete="email" />
                <span class="val-error">@Html.ValidationMessage("Email")</span>
            </div>

            <div class="field">
                <div class="field-row">
                    <label>Password</label>
                    <a href="#" class="forgot-link">Forgot password?</a>
                </div>
                <input type="password" name="Password" placeholder="••••••••" required autocomplete="current-password" />
                <span class="val-error">@Html.ValidationMessage("Password")</span>
            </div>

            @if (!string.IsNullOrEmpty(ViewData["LoginError"]?.ToString()))
            {
                <div style="background:#FDECEA; border-left:3px solid #D94040; padding:10px 14px; border-radius:6px; font-size:13px; color:#7A1E1E;">
                    @ViewData["LoginError"]
                </div>
            }

            <button type="submit" class="btn-login">Log in →</button>

            <div class="auth-divider">or</div>

            <div class="register-cta">
                New to PROSBEE? <a asp-controller="Account" asp-action="Register">Create a free account</a>
            </div>
        </form>
    </div>

</div>
