@section Scripts {
    <script>
        const tabData = {
            aes: {
                detail: '<strong>Customise your room</strong>Pick from curated decoration styles — minimal, nordic, tropical, urban, or wallpaper art. We source everything and set it up for you before you move in.',
                cta: 'Browse aesthetic styles →',
                href: '@Url.Action("Index", "Aesthetics")'
            },
            log: {
                detail: '<strong>Store your items</strong>Select what you want stored — fan, mattress, fridge and more. We pick up from your hostel door, keep everything safe, and return it when you\'re back.',
                cta: 'Start my storage order →',
                href: '@Url.Action("Index", "Logistics")'
            }
        };

        function switchTab(key) {
            document.querySelectorAll('.svc-tab').forEach(t => t.classList.remove('active'));
            document.getElementById('tab-' + key).classList.add('active');

            const detail = document.getElementById('svc-detail');
            detail.style.opacity = '0';
            setTimeout(() => {
                detail.innerHTML = tabData[key].detail;
                detail.style.opacity = '1';
            }, 150);

            const cta = document.getElementById('svc-cta');
            cta.textContent = tabData[key].cta;
            cta.href = tabData[key].href;
        }
    </script>
}
