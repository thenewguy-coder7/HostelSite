@{
    ViewData["Title"] = "Room Aesthetics";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;1,500&family=Outfit:wght@400;500;600&display=swap');

    :root {
        --forest: #1C3B2E;
        --forest-dark: #0D201A;
        --forest-mid: #2E6B52;
        --sage: #4A9572;
        --sage-light: #EAF3EE;
        --sage-muted: #9CBDAD;
        --amber: #C9863A;
        --amber-light: #FDF3E7;
        --amber-hover: #B5722A;
        --ink: #111318;
        --ink2: #3D3F47;
        --muted: #7C808C;
        --line: #E3E5EA;
        --sand: #F8F7F4;
        --white: #FFFFFF;
        --font-d: 'Montserrat', Georgia, serif;
        --font-b: 'Outfit', system-ui, sans-serif;
        --r: 10px;
    }

    .aes-page * {
        box-sizing: border-box;
    }

    .aes-page {
        font-family: var(--font-b);
        color: var(--ink);
        background: var(--sand);
    }

        .aes-page p, .aes-page h1, .aes-page h2, .aes-page h3, .aes-page h4 {
            margin: 0;
        }

        .aes-page a {
            text-decoration: none;
        }

    /* HEADER */
    .aes-header {
        background: var(--forest);
        padding: 3.5rem 3rem 3rem;
        text-align: center;
    }

    .aes-header-eyebrow {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1.8px;
        text-transform: uppercase;
        color: var(--sage);
        margin-bottom: 14px;
    }

    .aes-header h1 {
        font-family: var(--font-d);
        font-size: 44px;
        color: #fff;
        font-weight: 600;
        line-height: 1.15;
        letter-spacing: -0.3px;
        margin-bottom: 14px;
    }

        .aes-header h1 em {
            font-style: italic;
            color: #A8D8BF;
        }

    .aes-header p {
        font-size: 16px;
        color: var(--sage-muted);
        line-height: 1.75;
        max-width: 560px;
        margin: 0 auto;
    }

    /* STYLE GRID */
    .aes-body {
        max-width: 1200px;
        margin: 0 auto;
        padding: 3rem 3rem 5rem;
    }

    .style-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 28px;
    }

    .style-card {
        background: var(--white);
        border: 1.5px solid var(--line);
        border-radius: 18px;
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .style-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 16px 40px rgba(0,0,0,0.1);
        }

        .style-card.selected {
            border-color: var(--sage);
            box-shadow: 0 0 0 3px rgba(74,149,114,0.2);
        }

    .style-photo-wrap {
        position: relative;
        height: 260px;
        overflow: hidden;
        cursor: pointer;
    }

        .style-photo-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
            display: block;
        }

        .style-photo-wrap:hover img {
            transform: scale(1.05);
        }

    .style-photo-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, transparent 45%);
        display: flex;
        align-items: flex-end;
        padding: 1rem 1.25rem;
    }

    .style-badge {
        position: relative;
        z-index: 2;
        padding: 6px 14px;
        border-radius: 99px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.3px;
        background: rgba(255,255,255,0.92);
        color: var(--ink);
    }

    .view-gallery-hint {
        position: absolute;
        top: 12px;
        right: 12px;
        background: rgba(0,0,0,0.55);
        color: #fff;
        font-size: 11px;
        font-weight: 600;
        padding: 5px 10px;
        border-radius: 99px;
        display: flex;
        align-items: center;
        gap: 5px;
        z-index: 2;
    }

        .view-gallery-hint i {
            font-size: 13px;
        }

    /* CARD BODY */
    .style-body {
        padding: 1.5rem 1.75rem 1.75rem;
    }

    .style-body-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 8px;
    }

    .style-body h3 {
        font-family: var(--font-d);
        font-size: 20px;
        font-weight: 600;
        color: var(--ink);
    }

    .style-select-btn {
        border: 1.5px solid var(--line);
        background: transparent;
        color: var(--muted);
        font-size: 13px;
        font-weight: 500;
        padding: 6px 14px;
        border-radius: 99px;
        cursor: pointer;
        font-family: var(--font-b);
        transition: all 0.15s;
        white-space: nowrap;
    }

        .style-select-btn:hover, .style-card.selected .style-select-btn {
            background: var(--forest);
            border-color: var(--forest);
            color: #fff;
        }

    .style-body p {
        font-size: 14px;
        color: var(--muted);
        line-height: 1.65;
        margin-bottom: 14px;
    }

    .style-tags {
        display: flex;
        gap: 7px;
        flex-wrap: wrap;
    }

    .stag {
        font-size: 11px;
        font-weight: 500;
        padding: 4px 11px;
        border-radius: 99px;
    }

    .stag-sage {
        background: var(--sage-light);
        color: #1C5C40;
    }

    .stag-amber {
        background: var(--amber-light);
        color: #7A4B10;
    }

    .stag-ink {
        background: #ECEDF0;
        color: var(--ink2);
    }

    /* LIGHTBOX */
    .lightbox-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(13,32,26,0.92);
        z-index: 1000;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }

        .lightbox-overlay.open {
            display: flex;
        }

    .lightbox-content {
        max-width: 900px;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.25rem;
    }

    .lightbox-main {
        position: relative;
        width: 100%;
        max-height: 70vh;
        border-radius: 14px;
        overflow: hidden;
        background: #000;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .lightbox-main img {
            max-width: 100%;
            max-height: 70vh;
            object-fit: contain;
            display: block;
        }

    .lightbox-nav-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255,255,255,0.15);
        border: none;
        color: #fff;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        transition: background 0.15s;
        z-index: 2;
    }

        .lightbox-nav-btn:hover {
            background: rgba(255,255,255,0.3);
        }

        .lightbox-nav-btn.prev {
            left: 12px;
        }

        .lightbox-nav-btn.next {
            right: 12px;
        }

    .lightbox-close {
        position: absolute;
        top: -3rem;
        right: 0;
        background: none;
        border: none;
        color: #fff;
        font-size: 28px;
        cursor: pointer;
        line-height: 1;
    }

    .lightbox-thumbs {
        display: flex;
        gap: 10px;
    }

    .lightbox-thumb {
        width: 64px;
        height: 64px;
        border-radius: 8px;
        overflow: hidden;
        cursor: pointer;
        border: 2px solid transparent;
        opacity: 0.6;
        transition: opacity 0.15s, border-color 0.15s;
    }

        .lightbox-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .lightbox-thumb.active {
            opacity: 1;
            border-color: var(--sage);
        }

    .lightbox-title {
        color: #fff;
        font-family: var(--font-d);
        font-size: 18px;
        font-weight: 600;
        text-align: center;
        position: relative;
    }

    /* REQUEST FORM */
    .request-section {
        background: var(--forest);
        padding: 4rem 3rem;
    }

    .request-inner {
        max-width: 760px;
        margin: 0 auto;
    }

    .request-eyebrow {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1.8px;
        text-transform: uppercase;
        color: var(--sage);
        margin-bottom: 10px;
    }

    .request-inner h2 {
        font-family: var(--font-d);
        font-size: 36px;
        color: #fff;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .request-inner > p {
        font-size: 15px;
        color: var(--sage-muted);
        line-height: 1.7;
        margin-bottom: 2.5rem;
    }

    .request-form {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 16px;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
    }

    .form-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .form-field label {
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--sage-muted);
        }

        .form-field input, .form-field select, .form-field textarea {
            background: rgba(255,255,255,0.07);
            border: 1.5px solid rgba(255,255,255,0.12);
            border-radius: 8px;
            padding: 11px 14px;
            font-size: 14px;
            font-family: var(--font-b);
            color: #fff;
            outline: none;
            transition: border-color 0.15s, background 0.15s;
            width: 100%;
        }

            .form-field input::placeholder, .form-field textarea::placeholder {
                color: rgba(255,255,255,0.25);
            }

            .form-field select option {
                background: var(--forest-dark);
                color: #fff;
            }

            .form-field input:focus, .form-field select:focus, .form-field textarea:focus {
                border-color: var(--sage);
                background: rgba(255,255,255,0.1);
            }

        .form-field textarea {
            resize: vertical;
            min-height: 100px;
        }

    .selected-style-preview {
        background: rgba(74,149,114,0.12);
        border: 1px solid rgba(74,149,114,0.25);
        border-radius: 8px;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 14px;
        color: #A8D8BF;
    }

        .selected-style-preview strong {
            color: #fff;
        }

        .selected-style-preview span {
            font-size: 12px;
        }

    .btn-submit {
        background: var(--amber);
        border: none;
        color: #fff;
        padding: 14px;
        border-radius: 9px;
        font-size: 15px;
        font-weight: 600;
        font-family: var(--font-b);
        cursor: pointer;
        width: 100%;
        transition: background 0.15s;
        margin-top: 0.25rem;
    }

        .btn-submit:hover {
            background: var(--amber-hover);
        }

    @@media (max-width: 900px) {
        .style-grid {
            grid-template-columns: 1fr;
        }

        .form-row {
            grid-template-columns: 1fr;
        }

        .lightbox-nav-btn {
            width: 36px;
            height: 36px;
            font-size: 16px;
        }
    }

    @@media (max-width: 640px) {
        .aes-header {
            padding: 2.5rem 1.5rem 2rem;
        }

            .aes-header h1 {
                font-size: 32px;
            }

        .aes-body {
            padding: 2rem 1.5rem 3rem;
        }

        .request-section {
            padding: 3rem 1.5rem;
        }

        .style-photo-wrap {
            height: 200px;
        }

        .lightbox-thumbs {
            flex-wrap: wrap;
            justify-content: center;
        }
    }
</style>

<div class="aes-page">

    <!-- PAGE HEADER -->
    <div class="aes-header">
        <p class="aes-header-eyebrow">Room aesthetics</p>
        <h1>Choose your style.<br><em>We bring it to life.</em></h1>
        <p>Browse five curated decoration styles designed for hostel rooms. Pick the one that feels like you, fill in the request form, and our team handles everything.</p>
    </div>

    <!-- STYLE GRID -->
    <div class="aes-body">
        <div class="style-grid">

            <!-- MINIMAL CALM -->
            <div class="style-card" id="card-minimal" data-style="Minimal calm">
                <div class="style-photo-wrap" onclick="openLightbox('minimal')">
                    <img src="~/images/aesthetics/minimal-1.jpg" alt="Minimal calm room" />
                    <div class="style-photo-overlay">
                        <span class="style-badge">Minimal calm</span>
                    </div>
                    <span class="view-gallery-hint"><i class="ti ti-photo"></i> 3 photos</span>
                </div>
                <div class="style-body">
                    <div class="style-body-top">
                        <h3>Minimal calm</h3>
                        <button class="style-select-btn" id="btn-minimal" onclick="selectStyle('minimal', 'Minimal calm')">Select style</button>
                    </div>
                    <p>Clean lines, muted tones, and deliberate space. For students who think clearly in quiet, uncluttered rooms.</p>
                    <div class="style-tags">
                        <span class="stag stag-sage">Neutral palette</span>
                        <span class="stag stag-amber">Most popular</span>
                        <span class="stag stag-ink">Calm</span>
                    </div>
                </div>
            </div>

            <!-- NORDIC LIGHT -->
            <div class="style-card" id="card-nordic" data-style="Nordic light">
                <div class="style-photo-wrap" onclick="openLightbox('nordic')">
                    <img src="~/images/aesthetics/nordic-1.jpg" alt="Nordic light room" />
                    <div class="style-photo-overlay">
                        <span class="style-badge">Nordic light</span>
                    </div>
                    <span class="view-gallery-hint"><i class="ti ti-photo"></i> 3 photos</span>
                </div>
                <div class="style-body">
                    <div class="style-body-top">
                        <h3>Nordic light</h3>
                        <button class="style-select-btn" id="btn-nordic" onclick="selectStyle('nordic', 'Nordic light')">Select style</button>
                    </div>
                    <p>Warm string lights, soft wood tones, and cosy layered textures. Inviting without feeling cluttered.</p>
                    <div class="style-tags">
                        <span class="stag stag-sage">Warm tones</span>
                        <span class="stag stag-ink">Cosy</span>
                        <span class="stag stag-ink">Textured</span>
                    </div>
                </div>
            </div>

            <!-- TROPICAL GREENS -->
            <div class="style-card" id="card-tropical" data-style="Tropical greens">
                <div class="style-photo-wrap" onclick="openLightbox('tropical')">
                    <img src="~/images/aesthetics/tropical-1.jpg" alt="Tropical greens room" />
                    <div class="style-photo-overlay">
                        <span class="style-badge">Tropical greens</span>
                    </div>
                    <span class="view-gallery-hint"><i class="ti ti-photo"></i> 3 photos</span>
                </div>
                <div class="style-body">
                    <div class="style-body-top">
                        <h3>Tropical greens</h3>
                        <button class="style-select-btn" id="btn-tropical" onclick="selectStyle('tropical', 'Tropical greens')">Select style</button>
                    </div>
                    <p>Hanging vines, fairy lights, and lush greenery. A dreamy escape that still feels grounded.</p>
                    <div class="style-tags">
                        <span class="stag stag-sage">Fresh</span>
                        <span class="stag stag-sage">Natural</span>
                        <span class="stag stag-ink">Dreamy</span>
                    </div>
                </div>
            </div>

            <!-- URBAN EDGE -->
            <div class="style-card" id="card-urban" data-style="Urban edge">
                <div class="style-photo-wrap" onclick="openLightbox('urban')">
                    <img src="~/images/aesthetics/urban-1.jpg" alt="Urban edge room" />
                    <div class="style-photo-overlay">
                        <span class="style-badge">Urban edge</span>
                    </div>
                    <span class="view-gallery-hint"><i class="ti ti-photo"></i> 3 photos</span>
                </div>
                <div class="style-body">
                    <div class="style-body-top">
                        <h3>Urban edge</h3>
                        <button class="style-select-btn" id="btn-urban" onclick="selectStyle('urban', 'Urban edge')">Select style</button>
                    </div>
                    <p>Neon accent lighting, dark palette, and bold statement pieces. For rooms with a distinct point of view.</p>
                    <div class="style-tags">
                        <span class="stag stag-amber">Bold</span>
                        <span class="stag stag-ink">Dark</span>
                        <span class="stag stag-ink">Dramatic</span>
                    </div>
                </div>
            </div>

            <!-- WALLPAPER ART (full width) -->
            <div class="style-card" id="card-wallpaper" data-style="Wallpaper art" style="grid-column: 1 / -1;">
                <div class="style-photo-wrap" onclick="openLightbox('wallpaper')" style="height:220px;">
                    <img src="~/images/aesthetics/wallpaper-1.jpg" alt="Wallpaper art room" style="object-position: center 20%;" />
                    <div class="style-photo-overlay">
                        <span class="style-badge">Wallpaper art</span>
                    </div>
                    <span class="view-gallery-hint"><i class="ti ti-photo"></i> 3 photos</span>
                </div>
                <div class="style-body">
                    <div class="style-body-top">
                        <h3>Wallpaper art</h3>
                        <button class="style-select-btn" id="btn-wallpaper" onclick="selectStyle('wallpaper', 'Wallpaper art')">Select style</button>
                    </div>
                    <p>A curated poster and print collage covering your wall — music, film, and pop culture, arranged into one striking gallery wall.</p>
                    <div class="style-tags">
                        <span class="stag stag-amber">Statement wall</span>
                        <span class="stag stag-ink">Gallery style</span>
                        <span class="stag stag-sage">Personal</span>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- LIGHTBOX -->
    <div class="lightbox-overlay" id="lightboxOverlay">
        <div class="lightbox-content">
            <button class="lightbox-close" onclick="closeLightbox()"><i class="ti ti-x"></i></button>
            <div class="lightbox-title" id="lightboxTitle">Style</div>
            <div class="lightbox-main">
                <button class="lightbox-nav-btn prev" onclick="lightboxNav(-1)"><i class="ti ti-chevron-left"></i></button>
                <img id="lightboxImage" src="" alt="" />
                <button class="lightbox-nav-btn next" onclick="lightboxNav(1)"><i class="ti ti-chevron-right"></i></button>
            </div>
            <div class="lightbox-thumbs" id="lightboxThumbs"></div>
        </div>
    </div>

    <!-- REQUEST FORM -->
    <section class="request-section" id="requestSection">
        <div class="request-inner">
            <p class="request-eyebrow">Submit a request</p>
            <h2>Ready to get started?</h2>
            <p>Fill in your details below and we'll be in touch to confirm your aesthetic setup and timeline.</p>

            <form class="request-form" asp-controller="Aesthetics" asp-action="SubmitRequest" method="post">
                @Html.AntiForgeryToken()

                <div class="selected-style-preview" id="stylePreview">
                    <span>No style selected yet — <strong>pick one above</strong></span>
                    <span>↑ scroll up</span>
                </div>

                <input type="hidden" name="StyleName" id="styleNameInput" value="" />

                <div class="form-row">
                    <div class="form-field">
                        <label>First name</label>
                        <input type="text" name="FirstName" placeholder="Kwame" required />
                    </div>
                    <div class="form-field">
                        <label>Last name</label>
                        <input type="text" name="LastName" placeholder="Osei" required />
                    </div>
                </div>

                <div class="form-field">
                    <label>Email address</label>
                    <input type="email" name="Email" placeholder="kwame@email.com" required />
                </div>

                <div class="form-row">
                    <div class="form-field">
                        <label>Hostel / hall</label>
                        <input type="text" name="Hostel" placeholder="e.g. Fortune Royal" required />
                    </div>
                    <div class="form-field">
                        <label>Room number</label>
                        <input type="text" name="RoomNumber" placeholder="e.g. A204" required />
                    </div>
                </div>

                <div class="form-field">
                    <label>Preferred setup date</label>
                    <input type="date" name="PreferredDate" required />
                </div>

                <div class="form-field">
                    <label>Additional notes (optional)</label>
                    <textarea name="Notes" placeholder="Any specific preferences, colours you love or hate, items you already have in the room..."></textarea>
                </div>

                <button type="submit" class="btn-submit">
                    Submit aesthetic request →
                </button>
            </form>
        </div>
    </section>

</div>

@section Scripts {
    <script>
        let selectedStyle = null;

        // Photo galleries — 3 images per style
        const galleries = {
            minimal:   { title: 'Minimal calm',    images: ['/images/aesthetics/minimal-1.jpg',   '/images/aesthetics/minimal-2.jpg',   '/images/aesthetics/minimal-3.jpg'] },
            nordic:    { title: 'Nordic light',     images: ['/images/aesthetics/nordic-1.jpg',    '/images/aesthetics/nordic-2.jpg',    '/images/aesthetics/nordic-3.jpg'] },
            tropical:  { title: 'Tropical greens',  images: ['/images/aesthetics/tropical-1.jpg',  '/images/aesthetics/tropical-2.jpg',  '/images/aesthetics/tropical-3.jpg'] },
            urban:     { title: 'Urban edge',       images: ['/images/aesthetics/urban-1.jpg',     '/images/aesthetics/urban-2.jpg',     '/images/aesthetics/urban-3.jpg'] },
            wallpaper: { title: 'Wallpaper art',     images: ['/images/aesthetics/wallpaper-1.jpg', '/images/aesthetics/wallpaper-2.jpg', '/images/aesthetics/wallpaper-3.jpg'] }
        };

        let currentGallery = null;
        let currentIndex = 0;

        function openLightbox(key) {
            currentGallery = key;
            currentIndex = 0;
            renderLightbox();
            document.getElementById('lightboxOverlay').classList.add('open');
        }

        function closeLightbox() {
            document.getElementById('lightboxOverlay').classList.remove('open');
        }

        function lightboxNav(direction) {
            const imgs = galleries[currentGallery].images;
            currentIndex = (currentIndex + direction + imgs.length) % imgs.length;
            renderLightbox();
        }

        function renderLightbox() {
            const g = galleries[currentGallery];
            document.getElementById('lightboxTitle').textContent = g.title;
            document.getElementById('lightboxImage').src = g.images[currentIndex];
            document.getElementById('lightboxImage').alt = g.title;

            const thumbsEl = document.getElementById('lightboxThumbs');
            thumbsEl.innerHTML = g.images.map((src, i) => `
                <div class="lightbox-thumb ${i === currentIndex ? 'active' : ''}" onclick="jumpTo(${i})">
                    <img src="${src}" alt="thumb" />
                </div>
            `).join('');
        }

        function jumpTo(i) {
            currentIndex = i;
            renderLightbox();
        }

        // Close on outside click
        document.getElementById('lightboxOverlay').addEventListener('click', function (e) {
            if (e.target === this) closeLightbox();
        });

        // Keyboard navigation
        document.addEventListener('keydown', function (e) {
            if (!document.getElementById('lightboxOverlay').classList.contains('open')) return;
            if (e.key === 'Escape') closeLightbox();
            if (e.key === 'ArrowLeft') lightboxNav(-1);
            if (e.key === 'ArrowRight') lightboxNav(1);
        });

        function selectStyle(key, label) {
            document.querySelectorAll('.style-card').forEach(c => c.classList.remove('selected'));
            document.querySelectorAll('.style-select-btn').forEach(b => b.textContent = 'Select style');

            document.getElementById('card-' + key).classList.add('selected');
            document.getElementById('btn-' + key).textContent = '✓ Selected';
            selectedStyle = key;

            document.getElementById('styleNameInput').value = label;
            document.getElementById('stylePreview').innerHTML =
                `<span>Selected style: <strong>${label}</strong></span><span>✓</span>`;

            document.getElementById('requestSection').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        const dateInput = document.querySelector('input[name="PreferredDate"]');
        if (dateInput) dateInput.min = new Date().toISOString().split('T')[0];
    </script>
}
