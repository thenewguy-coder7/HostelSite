<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — PROSBEE</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/images/prosbee-icon.png" />
    <link rel="shortcut icon" type="image/png" href="~/images/prosbee-icon.png" />

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;900&family=Outfit:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- Tabler Icons -->
    <link href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@@latest/tabler-icons.min.css" rel="stylesheet" />

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Site stylesheet -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

    <style>
        :root {
            --forest: #0F1A2E;
            --forest-dark: #080F1D;
            --forest-mid: #1A2E47;
            --sage: #6BB5A6;
            --sage-light: #E8F5F2;
            --sage-muted: #A8CFC8;
            --amber: #D4735A;
            --amber-hover: #BE6048;
            --amber-light: #FBEEE9;
            --ink: #111318;
            --ink2: #3D3F47;
            --muted: #7C808C;
            --line: #E3E5EA;
            --sand: #F8F7F4;
            --white: #FFFFFF;
            --font-d: 'Montserrat', system-ui, sans-serif;
            --font-b: 'Outfit', system-ui, sans-serif;
            --r: 10px;
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        html, body {
            margin: 0 !important;
            padding: 0 !important;
            font-family: var(--font-b);
            background: var(--sand);
            color: var(--ink);
            font-size: 16px;
            line-height: 1.6;
        }

        a {
            color: var(--amber);
            text-decoration: none;
        }

            a:hover {
                color: var(--amber-hover);
            }

        /* ── HOW-IT-WORKS ICONS & NUMBERS — bright accent ── */
        .hiw-icon {
            background: rgba(212,115,90,0.18) !important;
        }

            .hiw-icon i {
                color: #FFB05C !important; /* bright coral-orange */
                font-size: 24px !important;
            }

        .hiw-num {
            color: #FF9D3C !important; /* vivid orange numbers */
            opacity: 1 !important;
        }

        /* ── HEADING FONTS ── */
        h1 {
            font-family: 'Montserrat', system-ui, sans-serif !important;
            font-weight: 900 !important;
        }

        h2, h3, h4, h5, h6,
        .sec-h, .log-header h1,
        .aes-header h1, .co-header h1,
        .summary-head h3, .order-panel-head h3,
        .sidebar-brand, .admin-topbar h1 {
            font-family: 'Montserrat', system-ui, sans-serif !important;
            font-weight: 700 !important;
        }

        /* ── NAVBAR ── */
        .site-nav {
            background: var(--forest);
            height: 68px;
            display: flex;
            align-items: center;
            padding: 0 2.5rem;
            position: sticky;
            top: 0;
            z-index: 200;
            gap: 2rem;
        }

            .site-nav .brand {
                display: flex;
                align-items: center;
                flex-shrink: 0;
                text-decoration: none;
            }

            .site-nav .nav-links {
                display: flex;
                gap: 1.75rem;
                list-style: none;
                margin: 0 auto;
                padding: 0;
            }

                .site-nav .nav-links a {
                    color: var(--sage-muted);
                    font-size: 14px;
                    font-weight: 500;
                    text-decoration: none;
                    transition: color 0.15s;
                    letter-spacing: 0.2px;
                }

                    .site-nav .nav-links a:hover {
                        color: #fff;
                    }

                    .site-nav .nav-links a.active {
                        color: #fff;
                        border-bottom: 1.5px solid var(--sage);
                        padding-bottom: 2px;
                    }

            .site-nav .nav-actions {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                flex-shrink: 0;
            }

        .student-greeting {
            font-size: 13px;
            font-weight: 500;
            color: var(--sage-muted);
        }

        /* Buttons */
        .btn-nav-ghost {
            background: transparent;
            border: 1px solid rgba(255,255,255,0.25);
            color: #fff;
            padding: 7px 18px;
            border-radius: var(--r);
            font-size: 13px;
            font-weight: 500;
            font-family: var(--font-b);
            cursor: pointer;
            text-decoration: none;
            transition: border-color 0.15s, background 0.15s;
            display: inline-block;
        }

            .btn-nav-ghost:hover {
                border-color: rgba(255,255,255,0.5);
                background: rgba(255,255,255,0.05);
                color: #fff;
            }

        .btn-nav-amber {
            background: var(--amber);
            border: none;
            color: #fff;
            padding: 7px 18px;
            border-radius: var(--r);
            font-size: 13px;
            font-weight: 600;
            font-family: var(--font-b);
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
        }

            .btn-nav-amber:hover {
                background: var(--amber-hover);
                color: #fff;
            }

        /* ── BUTTON LIFT + GLOW ── */
        .btn-amber-lg, .btn-nav-amber, .btn-pay, .btn-checkout, .btn-forest,
        .btn-add, .btn-login, .btn-register, .btn-submit {
            transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.15s !important;
        }

            .btn-amber-lg:hover, .btn-nav-amber:hover, .btn-pay:hover, .btn-checkout:hover,
            .btn-add:hover, .btn-register:hover, .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 24px rgba(212,115,90,0.4);
            }

            .btn-forest:hover, .btn-login:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 24px rgba(15,26,46,0.35);
            }

        /* ── TICKER BANNER ── */
        .ticker-wrap {
            background: var(--forest-dark);
            border-bottom: 1px solid rgba(255,255,255,0.08);
            overflow: hidden;
            white-space: nowrap;
            height: 36px;
            display: flex;
            align-items: center;
        }

        .ticker-track {
            display: inline-flex;
            align-items: center;
            gap: 0;
            animation: ticker-scroll 35s linear infinite;
            white-space: nowrap;
        }

        .ticker-wrap:hover .ticker-track {
            animation-play-state: paused;
        }

        @@keyframes ticker-scroll {
            0% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(-50%);
            }
        }

        .ticker-item {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            color: var(--sage-muted);
            padding: 0 1.5rem;
        }

            .ticker-item i {
                font-size: 13px;
                color: var(--amber);
            }

        .ticker-dot {
            color: rgba(255,255,255,0.2);
            font-size: 10px;
            flex-shrink: 0;
        }

        /* ── SCROLL REVEAL ── */
        .reveal {
            opacity: 0;
            transform: translateY(28px);
            transition: opacity 0.7s ease, transform 0.7s ease;
        }

            .reveal.visible {
                opacity: 1;
                transform: translateY(0);
            }

        /* ── CARD SHINE ── */
        .aes-card, .item-card, .log-item-card {
            position: relative;
            overflow: hidden;
        }

            .aes-card::after, .item-card::after {
                content: '';
                position: absolute;
                top: 0;
                left: -80%;
                width: 50%;
                height: 100%;
                background: linear-gradient(105deg, transparent, rgba(255,255,255,0.35), transparent);
                transition: left 0.6s ease;
                pointer-events: none;
            }

            .aes-card:hover::after, .item-card:hover::after {
                left: 130%;
            }

        /* Mobile hamburger */
        .nav-toggle {
            display: none;
            flex-direction: column;
            gap: 5px;
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px;
            margin-left: auto;
        }

            .nav-toggle span {
                display: block;
                width: 22px;
                height: 2px;
                background: #fff;
                border-radius: 2px;
                transition: transform 0.2s, opacity 0.2s;
            }

        /* Mobile drawer */
        .mobile-drawer {
            display: none;
            background: var(--forest);
            padding: 1rem 2rem 1.5rem;
            border-top: 1px solid rgba(255,255,255,0.08);
        }

            .mobile-drawer .drawer-links {
                list-style: none;
                padding: 0;
                margin: 0 0 1rem;
                display: flex;
                flex-direction: column;
                gap: 0.9rem;
            }

                .mobile-drawer .drawer-links a {
                    color: var(--sage-muted);
                    font-size: 15px;
                    font-weight: 500;
                    text-decoration: none;
                }

                    .mobile-drawer .drawer-links a:hover {
                        color: #fff;
                    }

            .mobile-drawer.open {
                display: block;
            }

        .drawer-actions {
            display: flex;
            gap: 0.75rem;
        }

            .drawer-actions a {
                flex: 1;
                text-align: center;
            }

        /* ── ALERTS ── */
        .alert-wrapper {
            max-width: 960px;
            margin: 1.25rem auto 0;
            padding: 0 1.5rem;
        }

        .alert-nest {
            padding: 0.7rem 1rem;
            border-radius: var(--r);
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            font-family: var(--font-b);
        }

            .alert-nest.success {
                background: #E8F5EE;
                border-left: 3px solid #2D9B5A;
                color: #1A5C34;
            }

            .alert-nest.error {
                background: #FDECEA;
                border-left: 3px solid #D94040;
                color: #7A1E1E;
            }

            .alert-nest.info {
                background: var(--amber-light);
                border-left: 3px solid var(--amber);
                color: #7A4B10;
            }

        /* ── MAIN ── */
        .site-main {
            min-height: calc(100vh - 68px - 200px);
            margin-top: 0;
            padding-top: 0;
        }

        /* ── FOOTER ── */
        .site-footer {
            background: var(--forest-dark);
            padding: 3rem 2.5rem 2rem;
        }

        .footer-inner {
            max-width: 1100px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            gap: 2.5rem;
            margin-bottom: 2rem;
        }

        .footer-brand {
            margin-bottom: 10px;
        }

        .site-footer p {
            font-size: 13px;
            color: #5A7A8C;
            line-height: 1.7;
            margin: 0;
        }

        .site-footer h5 {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--sage);
            margin-bottom: 12px;
        }

        .site-footer ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .site-footer ul li {
                margin-bottom: 8px;
            }

            .site-footer ul a {
                font-size: 13px;
                color: #5A7A8C;
                text-decoration: none;
                transition: color 0.15s;
            }

                .site-footer ul a:hover {
                    color: var(--sage);
                }

        .footer-bottom {
            max-width: 1100px;
            margin: 0 auto;
            border-top: 1px solid rgba(255,255,255,0.06);
            padding-top: 1.25rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
            color: #3A4A5C;
        }

            .footer-bottom a {
                color: #5A7A8C;
            }

                .footer-bottom a:hover {
                    color: var(--sage);
                }

        /* ── RESPONSIVE ── */
        @@media (max-width: 768px) {
            .site-nav .nav-links,
            .site-nav .nav-actions {
                display: none;
            }

            .nav-toggle {
                display: flex;
            }

            .footer-inner {
                grid-template-columns: 1fr 1fr;
                gap: 2rem;
            }
        }

        @@media (max-width: 480px) {
            .site-nav {
                padding: 0 1.25rem;
            }

            .footer-inner {
                grid-template-columns: 1fr;
            }

            .footer-bottom {
                flex-direction: column;
                gap: 4px;
                text-align: center;
            }
        }
    </style>
</head>
<body>

    <!-- ══ NAVBAR ══ -->
    <nav class="site-nav">
        <a asp-controller="Home" asp-action="Index" class="brand">
            <img src="~/images/prosbee-logo.png" alt="PROSBEE" style="height:145px; width:auto; max-width:260px; object-fit:contain;" />
        </a>

        <ul class="nav-links">
            <li>
                <a asp-controller="Home" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                    Home
                </a>
            </li>
            <li>
                <a asp-controller="Aesthetics" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Aesthetics" ? "active" : "")">
                    Aesthetics
                </a>
            </li>
            <li>
                <a asp-controller="Logistics" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Logistics" ? "active" : "")">
                    Logistics
                </a>
            </li>
        </ul>

        <div class="nav-actions">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <span class="student-greeting">Hi, @User.Identity.Name</span>
                <a asp-controller="Aesthetics" asp-action="MyRequests" class="btn-nav-ghost">My Requests</a>
                <a asp-controller="Logistics" asp-action="MyOrders" class="btn-nav-ghost">My Orders</a>
                <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-nav-ghost">Log out</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn-nav-ghost">Log in</a>
                <a asp-controller="Account" asp-action="Register" class="btn-nav-amber">Get started</a>
            }
        </div>

        <!-- Mobile hamburger -->
        <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </nav>

    <!-- ══ TICKER BANNER ══ -->
    <div class="ticker-wrap">
        <div class="ticker-track">
            <span class="ticker-item"><i class="ti ti-shield-check"></i> Secure storage at affordable rates</span>
            <span class="ticker-dot">•</span>
            <span class="ticker-item"><i class="ti ti-truck"></i> Flexible pickup &amp; return schedules</span>
            <span class="ticker-dot">•</span>
            <span class="ticker-item"><i class="ti ti-map-pin"></i> Find us at the KNUST Islamic Center (KIC)</span>
            <span class="ticker-dot">•</span>
            <span class="ticker-item"><i class="ti ti-calendar"></i> Booking now open for next semester!</span>
            <span class="ticker-dot">•</span>
            <span class="ticker-item"><i class="ti ti-users"></i> Trusted by 5,000+ KNUST students</span>
            <span class="ticker-dot">•</span>
            <span class="ticker-item"><i class="ti ti-palette"></i> Room aesthetics now available</span>
            <span class="ticker-dot">•</span>
            <span class="ticker-item"><i class="ti ti-credit-card"></i> Pay securely with Paystack</span>
            <span class="ticker-dot">•</span>
            <span class="ticker-item"><i class="ti ti-shield-check"></i> Secure storage at affordable rates</span>
            <span class="ticker-dot">•</span>
            <span class="ticker-item"><i class="ti ti-truck"></i> Flexible pickup &amp; return schedules</span>
            <span class="ticker-dot">•</span>
            <span class="ticker-item"><i class="ti ti-map-pin"></i> Find us at the KNUST Islamic Center (KIC)</span>
            <span class="ticker-dot">•</span>
            <span class="ticker-item"><i class="ti ti-calendar"></i> Booking now open for next semester!</span>
            <span class="ticker-dot">•</span>
            <span class="ticker-item"><i class="ti ti-users"></i> Trusted by 5,000+ KNUST students</span>
            <span class="ticker-dot">•</span>
            <span class="ticker-item"><i class="ti ti-palette"></i> Room aesthetics now available</span>
            <span class="ticker-dot">•</span>
            <span class="ticker-item"><i class="ti ti-credit-card"></i> Pay securely with Paystack</span>
            <span class="ticker-dot">•</span>
        </div>
    </div>

    <!-- ══ MOBILE DRAWER ══ -->
    <div class="mobile-drawer" id="mobileDrawer">
        <ul class="drawer-links">
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li><a asp-controller="Aesthetics" asp-action="Index">Aesthetics</a></li>
            <li><a asp-controller="Logistics" asp-action="Index">Logistics</a></li>
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <li><a asp-controller="Aesthetics" asp-action="MyRequests">My Requests</a></li>
                <li><a asp-controller="Logistics" asp-action="MyOrders">My Orders</a></li>
            }
        </ul>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-nav-ghost" style="width:100%;">Log out</button>
            </form>
        }
        else
        {
            <div class="drawer-actions">
                <a asp-controller="Account" asp-action="Login" class="btn-nav-ghost">Log in</a>
                <a asp-controller="Account" asp-action="Register" class="btn-nav-amber">Get started</a>
            </div>
        }
    </div>

    <!-- ══ TEMPDATA ALERTS ══ -->
    @if (TempData["Success"] != null)
    {
        <div class="alert-wrapper">
            <div class="alert-nest success">
                <i class="ti ti-circle-check"></i> @TempData["Success"]
            </div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-wrapper">
            <div class="alert-nest error">
                <i class="ti ti-circle-x"></i> @TempData["Error"]
            </div>
        </div>
    }

    @if (TempData["Info"] != null)
    {
        <div class="alert-wrapper">
            <div class="alert-nest info">
                <i class="ti ti-info-circle"></i> @TempData["Info"]
            </div>
        </div>
    }

    <!-- ══ PAGE CONTENT ══ -->
    <main class="site-main">
        @RenderBody()
    </main>

    <!-- ══ FOOTER ══ -->
    <footer class="site-footer">
        <div class="footer-inner">
            <div>
                <div class="footer-brand">
                    <img src="~/images/prosbee-logo.png" alt="PROSBEE" style="height:145px; width:auto;" />
                </div>
                <p>Room aesthetics and item storage for students — designed around campus life.</p>
            </div>

            <div>
                <h5>Services</h5>
                <ul>
                    <li><a asp-controller="Aesthetics" asp-action="Index">Room aesthetics</a></li>
                    <li><a asp-controller="Logistics" asp-action="Index">Item storage</a></li>
                </ul>
            </div>

            <div>
                <h5>Account</h5>
                <ul>
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li><a asp-controller="Aesthetics" asp-action="MyRequests">My requests</a></li>
                        <li><a asp-controller="Logistics" asp-action="MyOrders">My orders</a></li>
                    }
                    else
                    {
                        <li><a asp-controller="Account" asp-action="Login">Log in</a></li>
                        <li><a asp-controller="Account" asp-action="Register">Sign up</a></li>
                    }
                </ul>
            </div>

            <div>
                <h5>Support</h5>
                <ul>
                    <li><a asp-controller="Home" asp-action="About">About</a></li>
                    <li><a href="mailto:support@prosbee.com">Contact us</a></li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <span>&copy; @DateTime.Now.Year PROSBEE. All rights reserved.</span>
            <span>Payments secured by <a href="https://paystack.com" target="_blank" rel="noopener">Paystack</a></span>
        </div>
    </footer>

    <!-- ══ SCRIPTS ══ -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Mobile nav toggle
        const toggle = document.getElementById('navToggle');
        const drawer = document.getElementById('mobileDrawer');

        if (toggle && drawer) {
            toggle.addEventListener('click', () => {
                const isOpen = drawer.classList.toggle('open');
                toggle.setAttribute('aria-expanded', isOpen);
            });
        }

        // Auto-dismiss alerts after 5s
        document.querySelectorAll('.alert-nest').forEach(el => {
            setTimeout(() => {
                el.style.transition = 'opacity 0.4s';
                el.style.opacity    = '0';
                setTimeout(() => el.remove(), 400);
            }, 5000);
        });

        // Scroll reveal
        const revealObserver = new IntersectionObserver((entries) => {
            entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
        }, { threshold: 0.12 });

        document.querySelectorAll('.sec, .hiw-card, .aes-card, .log-item-card, .proof-card, .item-card')
            .forEach(el => { el.classList.add('reveal'); revealObserver.observe(el); });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
